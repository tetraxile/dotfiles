#!/bin/zsh

if [ -z $button ] ; then
	_output=$(colorpicker -r)
	_r=$(echo $_output | cut -d',' -f1)
	_g=$(echo $_output | cut -d',' -f2)
	_b=$(echo $_output | cut -d',' -f3)
	_hex=$(printf "#%02x%02x%02x" $_r $_g $_b)
	# _hex=$(echo $_output | cut -d' ' -f9)
	_y=$(( ($_r + $_r + $_b + $_g + $_g + $_g) / 6 ))
	if (( $_y > 128 )) ; then
		_fg="#000000"
	else
		_fg="#ffffff"
	fi

	_out="<span foreground='${_hex}' background='#000000' size='large'></span><span background='${_hex}'> <span foreground='${_fg}'>col</span></span> ${_r}, ${_g}, ${_b} <span foreground='${_hex}' background='#000000' size='large'></span>"
	
	echo $_out
	echo $_out
	echo $_fg
	echo $_hex
fi
