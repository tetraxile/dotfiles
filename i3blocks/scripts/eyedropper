#!/bin/sh

if [ -z $button ] ; then
	_output=$(colorpicker -r)
	_r=$(echo $_output | cut -d',' -f1)
	_g=$(echo $_output | cut -d',' -f2)
	_b=$(echo $_output | cut -d',' -f3)
	_hex=$(printf "#%02x%02x%02x" $_r $_g $_b)
	# _hex=$(echo $_output | cut -d' ' -f9)
	_y=$(( ($_r + $_r + $_b + $_g + $_g + $_g) / 6 ))
	echo 󰈊 $_r, $_g, $_b
	echo 󰈊 $_r, $_g, $_b
	if (( $_y > 128 )) ; then
		echo "#000000"
	else
		echo "#ffffff"
	fi
	echo $_hex
fi
